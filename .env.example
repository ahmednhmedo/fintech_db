# Copy this file to `.env` (gitignored). run_gold.ps1 loads it and the silver
# loader reads WH_* from the environment. dbt's own connection is governed by the
# dbt profile `fintech_db` (~/.dbt/profiles.yml), NOT this file.

# ---- Warehouse target (HOST side, Windows auth) ----
WH_SERVER=ahmed\SQLEXPRESS
WH_DATABASE=fintech_db
WH_DRIVER=ODBC Driver 18 for SQL Server
# Leave WH_USER / WH_PASSWORD UNSET -> Trusted_Connection (Windows auth).
# Do NOT set them: this project is Windows-auth only.

# ---- Container-side paths (informational; actually set in docker-compose.yml) ----
# RAW_DIR=/opt/data/raw     # 8 source CSVs
# LAKE_DIR=/opt/data/lake   # bronze/ + silver/ parquet
